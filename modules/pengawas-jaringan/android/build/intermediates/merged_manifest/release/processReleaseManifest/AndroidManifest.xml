<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.nanumhr.pengawas" >

    <uses-sdk android:minSdkVersion="24" />

    <application>

        <!--
      JobService wajib mengumumkan dirinya dan wajib dilindungi izin ini —
      tanpanya JobScheduler menolak menjadwalkannya sama sekali. `exported=false`
      karena satu-satunya yang boleh memanggilnya adalah sistem.
        -->
        <service
            android:name="app.nanumhr.pengawas.PengawasJaringanJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>

</manifest>